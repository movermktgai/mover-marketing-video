# Mover Marketing Video local proof configuration.
# Copy to .env and replace every placeholder before running local web/desktop builds.
# Keep NEXT_PUBLIC_IS_CAP empty for self-host mode; the current fork treats self-host users as upgraded.

CAP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_IS_CAP=
VITE_SERVER_URL=http://localhost:3000
CAP_ALLOWED_SIGNUP_DOMAINS=example.com,example.org

DATABASE_URL=mysql://cap:REPLACE_WITH_LOCAL_MYSQL_PASSWORD@127.0.0.1:3306/cap
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_ROOT_PASSWORD
NEXTAUTH_SECRET=REPLACE_WITH_32_BYTE_SECRET
DATABASE_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_SECRET
MEDIA_SERVER_WEBHOOK_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

CAP_AWS_BUCKET=cap
CAP_AWS_REGION=auto
CAP_AWS_ACCESS_KEY=REPLACE_WITH_R2_OR_MINIO_ACCESS_KEY
CAP_AWS_SECRET_KEY=REPLACE_WITH_R2_OR_MINIO_SECRET_KEY
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

MEDIA_SERVER_URL=http://localhost:3456
MEDIA_SERVER_WEBHOOK_URL=http://localhost:3000

RESEND_API_KEY=
RESEND_FROM_DOMAIN=
LOOPS_API_KEY=
LOOPS_LOGIN_TRANSACTIONAL_ID=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
