<Style
  backgroundColor="#F3F7FF"
  bodyColor="#FFFFFF"
  bodyXPadding="32"
  bodyYPadding="32"
  borderColor="#E5ECF7"
  borderWidth="1"
  borderRadius="18"
  bodyFontFamily="Inter"
  bodyFontCategory="sans-serif"
  textBaseColor="#243044"
  textBaseFontSize="15"
  textBaseLineHeight="155"
  textLinkColor="#0066FF"
  heading1Color="#0B1220"
  heading1FontSize="28"
  heading1LineHeight="120"
  buttonBodyColor="#0066FF"
  buttonTextColor="#FFFFFF"
  buttonBorderRadius="12"
  buttonBodyXPadding="22"
  buttonBodyYPadding="13"
  dividerColor="#E5ECF7"
/>
<H1 align="center">Sign in to {data.appName}</H1>
<Paragraph align="center" fontSize="16" lineHeight="155">
  Use this verification code to finish signing in as <Strong>{data.email}</Strong>.
</Paragraph>
<H1
  align="center"
  fontSize="38"
  lineHeight="120"
  blockColor="#F3F7FF"
  blockBorderRadius="14"
  paddingTop="18"
  paddingBottom="18"
>
  {data.verificationCode}
</H1>
<Paragraph align="center" fontSize="14" lineHeight="155">
  This code expires in {data.expiryMinutes} minutes.
</Paragraph>
<Button href="{data.magicLinkUrl}" align="center" bgColor="#0066FF" textColor="#FFFFFF" borderRadius="12" notrack="true">
  Open {data.appName}
</Button>
<Divider paddingTop="18" paddingBottom="18" />
<Paragraph fontSize="14" lineHeight="155">
  If the button does not work, copy and paste this link into your browser:
  <Br />
  <Link href="{data.magicLinkUrl}" notrack="true">{data.magicLinkUrl}</Link>
</Paragraph>
<Paragraph fontSize="13" lineHeight="150">
  If you did not request this code, you can ignore this email.
</Paragraph>
<Paragraph fontSize="12" lineHeight="150">
  {data.noReplyMessage}
</Paragraph>
