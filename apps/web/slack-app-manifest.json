{
	"_metadata": {
		"major_version": 1,
		"minor_version": 1
	},
	"display_information": {
		"name": "Mover Marketing Video",
		"description": "Use Mover Marketing Video directly inside Slack.",
		"background_color": "#0066FF"
	},
	"features": {
		"bot_user": {
			"display_name": "Mover Marketing Video",
			"always_online": false
		},
		"unfurl_domains": ["video.example.com"]
	},
	"oauth_config": {
		"redirect_urls": [
			"https://video.example.com/api/integrations/slack/callback"
		],
		"scopes": {
			"bot": ["links:read", "links:write", "links.embed:write"]
		}
	},
	"settings": {
		"event_subscriptions": {
			"request_url": "https://video.example.com/api/integrations/slack/events",
			"bot_events": ["link_shared", "app_uninstalled"]
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
